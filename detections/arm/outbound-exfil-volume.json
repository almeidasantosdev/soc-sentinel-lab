{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Nome do workspace de Log Analytics do laboratório."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/providers/alertRules",
      "apiVersion": "2023-02-01-preview",
      "name": "[concat(parameters('workspaceName'), '/Microsoft.SecurityInsights/', '3cc9d02e-ab7b-5936-b31e-df9229ce7f0d')]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "Volume anômalo de saída para IP público",
        "description": "Esta consulta identifica volume alto de bytes enviados para um\nendereço IP público em tráfego permitido. O sinal é compatível com\nexfiltração por um canal já liberado no firewall.",
        "severity": "High",
        "enabled": false,
        "query": "let byteThreshold = 100000000;\nCommonSecurityLog\n| where DeviceAction in~ (\"allow\", \"allowed\", \"accept\", \"accepted\")\n| where SentBytes > 0\n| where isnotempty(SourceIP) and isnotempty(DestinationIP)\n| where ipv4_is_private(DestinationIP) == false\n| summarize\n    BytesOut = sum(SentBytes),\n    Ports = make_set(DestinationPort, 5),\n    StartTime = min(TimeGenerated),\n    EndTime = max(TimeGenerated)\n    by SourceIP, DestinationIP, SourceUserName\n| where BytesOut >= byteThreshold\n| extend\n    BytesOutText = tostring(BytesOut),\n    PortsText = strcat_array(Ports, \",\")",
        "queryFrequency": "PT1H",
        "queryPeriod": "PT1H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionDuration": "PT1H",
        "suppressionEnabled": false,
        "tactics": [
          "Exfiltration"
        ],
        "techniques": [
          "T1048",
          "T1567"
        ],
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "FullName",
                "columnName": "SourceUserName"
              }
            ]
          },
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "DestinationIP"
              }
            ]
          },
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "SourceIP"
              }
            ]
          }
        ],
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        },
        "incidentConfiguration": {
          "createIncident": true,
          "groupingConfiguration": {
            "enabled": false,
            "reopenClosedIncident": false,
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "groupByEntities": [],
            "groupByAlertDetails": [],
            "groupByCustomDetails": []
          }
        },
        "customDetails": {
          "BytesOut": "BytesOutText",
          "Ports": "PortsText"
        },
        "alertDetailsOverride": {
          "alertDisplayNameFormat": "Saída volumosa de {{SourceUserName}} para {{DestinationIP}}",
          "alertDescriptionFormat": "{{BytesOutText}} bytes enviados para um IP público."
        }
      }
    }
  ]
}
