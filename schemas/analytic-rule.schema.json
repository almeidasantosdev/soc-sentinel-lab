{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/almeidasantosdev/soc-sentinel-lab/schemas/analytic-rule.schema.json",
  "title": "Regra analitica agendada no formato da comunidade do Microsoft Sentinel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "severity",
    "requiredDataConnectors",
    "queryFrequency",
    "queryPeriod",
    "triggerOperator",
    "triggerThreshold",
    "status",
    "tactics",
    "relevantTechniques",
    "query",
    "entityMappings",
    "eventGroupingSettings",
    "falsePositives",
    "version",
    "kind"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 10,
      "maxLength": 90
    },
    "description": {
      "type": "string",
      "minLength": 40
    },
    "severity": {
      "enum": ["Informational", "Low", "Medium", "High"]
    },
    "requiredDataConnectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connectorId", "dataTypes"],
        "properties": {
          "connectorId": {
            "type": "string",
            "minLength": 2
          },
          "dataTypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        }
      }
    },
    "queryFrequency": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(m|h|d)$"
    },
    "queryPeriod": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(m|h|d)$"
    },
    "triggerOperator": {
      "enum": ["gt", "lt", "eq"]
    },
    "triggerThreshold": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "status": {
      "enum": ["Available"]
    },
    "tactics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Reconnaissance",
          "ResourceDevelopment",
          "InitialAccess",
          "Execution",
          "Persistence",
          "PrivilegeEscalation",
          "DefenseEvasion",
          "CredentialAccess",
          "Discovery",
          "LateralMovement",
          "Collection",
          "CommandAndControl",
          "Exfiltration",
          "Impact"
        ]
      }
    },
    "relevantTechniques": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      }
    },
    "query": {
      "type": "string",
      "minLength": 40
    },
    "entityMappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityType", "fieldMappings"],
        "properties": {
          "entityType": {
            "enum": [
              "Account",
              "Host",
              "IP",
              "Malware",
              "File",
              "Process",
              "CloudApplication",
              "DNS",
              "AzureResource",
              "FileHash",
              "RegistryKey",
              "RegistryValue",
              "SecurityGroup",
              "URL",
              "Mailbox",
              "MailCluster",
              "MailMessage",
              "SubmissionMail"
            ]
          },
          "fieldMappings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identifier", "columnName"],
              "properties": {
                "identifier": {
                  "type": "string",
                  "minLength": 2
                },
                "columnName": {
                  "type": "string",
                  "minLength": 2
                }
              }
            }
          }
        }
      }
    },
    "customDetails": {
      "type": "object",
      "maxProperties": 20,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "alertDetailsOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "alertDisplayNameFormat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "alertDescriptionFormat": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "alertTacticsColumnName": {
          "type": "string"
        },
        "alertSeverityColumnName": {
          "type": "string"
        }
      }
    },
    "eventGroupingSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregationKind"],
      "properties": {
        "aggregationKind": {
          "enum": ["SingleAlert", "AlertPerResult"]
        }
      }
    },
    "falsePositives": {
      "type": "string",
      "minLength": 30
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "kind": {
      "const": "Scheduled"
    }
  }
}
