{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/almeidasantosdev/soc-sentinel-lab/schemas/hunting-query.schema.json",
  "title": "Consulta de cacada no formato da comunidade do Microsoft Sentinel",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "description",
    "requiredDataConnectors",
    "tactics",
    "relevantTechniques",
    "query",
    "entityMappings",
    "falsePositives",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 10,
      "maxLength": 90
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 255
    },
    "requiredDataConnectors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["connectorId", "dataTypes"],
        "properties": {
          "connectorId": {
            "type": "string",
            "minLength": 2
          },
          "dataTypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 2
            }
          }
        }
      }
    },
    "tactics": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Reconnaissance",
          "ResourceDevelopment",
          "InitialAccess",
          "Execution",
          "Persistence",
          "PrivilegeEscalation",
          "DefenseEvasion",
          "CredentialAccess",
          "Discovery",
          "LateralMovement",
          "Collection",
          "CommandAndControl",
          "Exfiltration",
          "Impact"
        ]
      }
    },
    "relevantTechniques": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      }
    },
    "query": {
      "type": "string",
      "minLength": 40
    },
    "entityMappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entityType", "fieldMappings"],
        "properties": {
          "entityType": {
            "type": "string"
          },
          "fieldMappings": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["identifier", "columnName"],
              "properties": {
                "identifier": {
                  "type": "string"
                },
                "columnName": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "falsePositives": {
      "type": "string",
      "minLength": 20
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    }
  }
}
